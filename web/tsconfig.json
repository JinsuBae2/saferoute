{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["node"],

    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,

    "baseUrl": ".",
    "paths": {
      "@contracts": ["../contracts/types.generated"],
      "@samples": ["../contracts/samples.generated"],
      "@space/*": ["../data/space/*"]
    }
  },
  "include": ["src", "vite.config.ts", "../contracts/types.generated.ts"]
}
