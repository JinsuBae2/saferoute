# Include inside the site's server {}. Keep this location before the generic /api/ example.
# No trailing URI on proxy_pass: preserve /api/explanations/current.
location ^~ /api/explanations/ {
    proxy_pass http://127.0.0.1:8002;
    proxy_read_timeout 3s;
    proxy_connect_timeout 1s;
    proxy_cache off;
}
